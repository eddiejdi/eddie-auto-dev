FROM gemma3:1b

# gemma3-fast:gpu1 — modelo rápido pinado na GPU1 (GTX 1050 2GB, porta :11435)
# Base: gemma3:1b em Q4_K_M (GGUF quantizado). Política sem LLM chinês (2026-07-01).
# 2026-07-30: ctx reduzido 2048→1024 e num_predict 256→384 p/ caber melhor nos 2GB
# (KV cache + quant Q4; OLLAMA_KV_CACHE_TYPE=q4_0 no serviço).
#
# Criação (homelab):
#   OLLAMA_HOST=127.0.0.1:11435 ollama create gemma3-fast:gpu1 -f models/Modelfile.gemma3-fast

PARAMETER temperature 0.05
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER num_ctx 1024
PARAMETER num_predict 384
PARAMETER repeat_penalty 1.1
PARAMETER num_gpu 99
PARAMETER stop "```"
PARAMETER stop "Resposta:"
PARAMETER stop "Análise:"
