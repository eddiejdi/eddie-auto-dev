[Unit]
Description=Forward Sia public ports to macvlan node
After=network-online.target sia-host-shim.service docker.service
Wants=network-online.target sia-host-shim.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -t nat -C POSTROUTING -o sia-host0 -j MASQUERADE -m comment --comment sia-macvlan-forward 2>/dev/null || iptables -t nat -A POSTROUTING -o sia-host0 -j MASQUERADE -m comment --comment sia-macvlan-forward; iptables -t nat -C PREROUTING -i eth-wan -p tcp --dport 9981 -j DNAT --to-destination 192.168.15.252:9981 -m comment --comment sia-macvlan-forward 2>/dev/null || iptables -t nat -A PREROUTING -i eth-wan -p tcp --dport 9981 -j DNAT --to-destination 192.168.15.252:9981 -m comment --comment sia-macvlan-forward; iptables -t nat -C PREROUTING -i eth-wan -p tcp --dport 9984 -j DNAT --to-destination 192.168.15.252:9984 -m comment --comment sia-macvlan-forward 2>/dev/null || iptables -t nat -A PREROUTING -i eth-wan -p tcp --dport 9984 -j DNAT --to-destination 192.168.15.252:9984 -m comment --comment sia-macvlan-forward; iptables -t nat -C PREROUTING -i eth-wan -p udp --dport 9984 -j DNAT --to-destination 192.168.15.252:9984 -m comment --comment sia-macvlan-forward 2>/dev/null || iptables -t nat -A PREROUTING -i eth-wan -p udp --dport 9984 -j DNAT --to-destination 192.168.15.252:9984 -m comment --comment sia-macvlan-forward; iptables -t nat -C POSTROUTING -o sia-host0 -p tcp -d 192.168.15.252 --dport 9981 -j SNAT --to-source 192.168.15.2 -m comment --comment sia-macvlan-forward 2>/dev/null || iptables -t nat -A POSTROUTING -o sia-host0 -p tcp -d 192.168.15.252 --dport 9981 -j SNAT --to-source 192.168.15.2 -m comment --comment sia-macvlan-forward; iptables -t nat -C POSTROUTING -o sia-host0 -p tcp -d 192.168.15.252 --dport 9984 -j SNAT --to-source 192.168.15.2 -m comment --comment sia-macvlan-forward 2>/dev/null || iptables -t nat -A POSTROUTING -o sia-host0 -p tcp -d 192.168.15.252 --dport 9984 -j SNAT --to-source 192.168.15.2 -m comment --comment sia-macvlan-forward; iptables -t nat -C POSTROUTING -o sia-host0 -p udp -d 192.168.15.252 --dport 9984 -j SNAT --to-source 192.168.15.2 -m comment --comment sia-macvlan-forward 2>/dev/null || iptables -t nat -A POSTROUTING -o sia-host0 -p udp -d 192.168.15.252 --dport 9984 -j SNAT --to-source 192.168.15.2 -m comment --comment sia-macvlan-forward; iptables -C FORWARD -i eth-wan -o sia-host0 -d 192.168.15.252 -p tcp --dport 9981 -j ACCEPT -m comment --comment sia-macvlan-forward 2>/dev/null || iptables -A FORWARD -i eth-wan -o sia-host0 -d 192.168.15.252 -p tcp --dport 9981 -j ACCEPT -m comment --comment sia-macvlan-forward; iptables -C FORWARD -i eth-wan -o sia-host0 -d 192.168.15.252 -p tcp --dport 9984 -j ACCEPT -m comment --comment sia-macvlan-forward 2>/dev/null || iptables -A FORWARD -i eth-wan -o sia-host0 -d 192.168.15.252 -p tcp --dport 9984 -j ACCEPT -m comment --comment sia-macvlan-forward; iptables -C FORWARD -i eth-wan -o sia-host0 -d 192.168.15.252 -p udp --dport 9984 -j ACCEPT -m comment --comment sia-macvlan-forward 2>/dev/null || iptables -A FORWARD -i eth-wan -o sia-host0 -d 192.168.15.252 -p udp --dport 9984 -j ACCEPT -m comment --comment sia-macvlan-forward; iptables -C FORWARD -i sia-host0 -o eth-wan -s 192.168.15.252 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT -m comment --comment sia-macvlan-forward 2>/dev/null || iptables -A FORWARD -i sia-host0 -o eth-wan -s 192.168.15.252 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT -m comment --comment sia-macvlan-forward'
ExecStop=/bin/sh -c 'iptables -t nat -D POSTROUTING -o sia-host0 -j MASQUERADE -m comment --comment sia-macvlan-forward 2>/dev/null || true; iptables -t nat -D PREROUTING -i eth-wan -p tcp --dport 9981 -j DNAT --to-destination 192.168.15.252:9981 -m comment --comment sia-macvlan-forward 2>/dev/null || true; iptables -t nat -D PREROUTING -i eth-wan -p tcp --dport 9984 -j DNAT --to-destination 192.168.15.252:9984 -m comment --comment sia-macvlan-forward 2>/dev/null || true; iptables -t nat -D PREROUTING -i eth-wan -p udp --dport 9984 -j DNAT --to-destination 192.168.15.252:9984 -m comment --comment sia-macvlan-forward 2>/dev/null || true; iptables -t nat -D POSTROUTING -o sia-host0 -p tcp -d 192.168.15.252 --dport 9981 -j SNAT --to-source 192.168.15.2 -m comment --comment sia-macvlan-forward 2>/dev/null || true; iptables -t nat -D POSTROUTING -o sia-host0 -p tcp -d 192.168.15.252 --dport 9984 -j SNAT --to-source 192.168.15.2 -m comment --comment sia-macvlan-forward 2>/dev/null || true; iptables -t nat -D POSTROUTING -o sia-host0 -p udp -d 192.168.15.252 --dport 9984 -j SNAT --to-source 192.168.15.2 -m comment --comment sia-macvlan-forward 2>/dev/null || true; iptables -D FORWARD -i eth-wan -o sia-host0 -d 192.168.15.252 -p tcp --dport 9981 -j ACCEPT -m comment --comment sia-macvlan-forward 2>/dev/null || true; iptables -D FORWARD -i eth-wan -o sia-host0 -d 192.168.15.252 -p tcp --dport 9984 -j ACCEPT -m comment --comment sia-macvlan-forward 2>/dev/null || true; iptables -D FORWARD -i eth-wan -o sia-host0 -d 192.168.15.252 -p udp --dport 9984 -j ACCEPT -m comment --comment sia-macvlan-forward 2>/dev/null || true; iptables -D FORWARD -i sia-host0 -o eth-wan -s 192.168.15.252 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT -m comment --comment sia-macvlan-forward 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
