[Unit]
Description=Eddie X Agent — X.com (Twitter) Integration
After=network-online.target secrets-agent.service
Wants=network-online.target

[Service]
Type=simple
User=homelab
WorkingDirectory=/home/homelab/eddie-auto-dev
Environment=PYTHONUNBUFFERED=1
Environment=SECRETS_AGENT_URL=http://localhost:8088
# A chave do Secrets Agent nunca inline — este unit é versionado num repo
# público. Ver docs/INCIDENTS/2026-07-28_SECRETS_IN_PUBLIC_REPO.md.
EnvironmentFile=-/etc/crypto-agent/secrets-api.env
Environment=X_AGENT_PORT=8515
ExecStart=/home/homelab/eddie-auto-dev/.venv/bin/python -m uvicorn tools.x_agent.x_agent:app --host 0.0.0.0 --port 8515
Restart=always
RestartSec=10
MemoryMax=256M

[Install]
WantedBy=multi-user.target
